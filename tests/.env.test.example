# Test Credentials Configuration
# Copy this file to .env.test and fill in your actual credentials
# NEVER commit .env.test to version control

# Office Operations Frontend Test Credentials
TEST_OFFICE_EMAIL=your-test-email@example.com
TEST_OFFICE_PASSWORD=your-secure-test-password

# Chatbot Test Credentials  
TEST_CHATBOT_EMAIL=your-test-email@example.com
TEST_CHATBOT_PASSWORD=your-secure-test-password

# Beta Authentication (for chatbot e2e specs)
BETA_PASSWORD=your-beta-password

# CloudFront URLs (update for your deployment)
CLOUDFRONT_URL=https://your-cloudfront-url.cloudfront.net
CLOUDFRONT_CHAT_URL=https://your-cloudfront-url.cloudfront.net/chat

# Playwright Frontend URL (for e2e specs)
PLAYWRIGHT_FRONTEND_URL=https://your-cloudfront-url.cloudfront.net

# Screenshot directory (optional, defaults to tests/screenshots/e2e)
SCREENSHOT_DIR=tests/screenshots/e2e
