{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "db/**/*.ts",
    "tests/**/*",
    "services/office-ops/src/**/*",
    "services/office-ops/server/**/*",
    "vitest.config.ts"
  ]
}
