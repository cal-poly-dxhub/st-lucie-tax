POSTGRES_DB=db_name
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_password
PGHOST=localhost
SENDER_EMAIL=your-verified-ses-email@example.com

# AuthID credentials (obtain from the AuthID console)
AUTHID_API_KEY_ID=your-authid-api-key-id
AUTHID_API_KEY_VALUE=your-authid-api-key-value

# Optional custom domain configuration
CUSTOM_DOMAIN_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/your-certificate-id
CUSTOM_DOMAIN_NAME=your-domain.example.com

# Shared secret sent by CloudFront when routing requests to protected API origins
ORIGIN_SECRET=generate-a-long-random-secret
