# ─── Local development (Docker Compose PostgreSQL) ───────────────────────────
# Keep these as stlucie/stlucie/localdev — db/reset.sh and the integration-test
# harness psql in as user/db "stlucie" and ignore other values.
POSTGRES_DB=stlucie
POSTGRES_USER=stlucie
POSTGRES_PASSWORD=localdev
PGHOST=localhost

# ─── Deploy (CDK synth/deploy) — REQUIRED ────────────────────────────────────
# Verified SES sender identity. Required by BackOffice synth (env-config.ts).
SENDER_EMAIL=your-verified-ses-email@example.com
# Shared secret CloudFront injects when routing to the protected API origins.
# MUST be changed from this placeholder — generate one with:
#   openssl rand -base64 32
# A synth-time guard rejects the literal placeholder below.
ORIGIN_SECRET=generate-a-long-random-secret

# ─── Deploy — set after the FIRST BackOffice deploy (see infra/DEPLOY.md) ─────
# Physical name of the BackOffice DocumentsBucket, read from the BackOffice
# `DocumentsBucketName` stack output. The chatbot doc-bridge writes validated
# uploads here so the clerk view can see them. Leave BLANK on the first deploy;
# the Chatbot stack imports the live bucket from the BackOffice stack export, so
# this override is only needed if you ever recreate the bucket out-of-band.
DOCUMENTS_BUCKET_NAME=
# Public base URL used in customer email links (confirmation/reschedule/queue).
# NO default. The BackOffice functions send these emails but deploy BEFORE the
# CloudFront domain exists, so they cannot auto-discover it. Options (infra/
# DEPLOY.md §7): set CUSTOM_DOMAIN_NAME below (links derive from it, no second
# pass), OR leave blank for the first deploy, then set BASE_URL to the Chatbot
# `FrontendUrl` output and redeploy BackOffice. Blank = email links non-functional
# (moot until SES leaves the sandbox).
BASE_URL=

# ─── Deploy — OPTIONAL ───────────────────────────────────────────────────────
# Email recipient for the Chatbot stack's Bedrock/error/throttle SNS alarms.
# Leave blank to skip alarm notifications.
ALARM_EMAIL=

# AuthID biometric verification (chatbot verify-identity). Optional: with keys
# unset the identity step degrades to a skip-only "unavailable" gate. Obtain a
# tenant + keys from the AuthID console; re-verify AUTHID_DL_DOC_TYPE_CODE
# against your tenant's GET /v1/idDocumentTypes (per-tenant; UAT used "2").
AUTHID_BASE_URL=https://id-uat.authid.ai
AUTHID_API_KEY_ID=
AUTHID_API_KEY_VALUE=
AUTHID_DL_DOC_TYPE_CODE=2
# How the proof classifier treats a required tamper signal the tenant did not
# emit: "ignore" (default, fail-open — judge only on signals present) or
# "reject" (fail-closed). Our UAT tenant emits no tamper signals, so "reject"
# would reject every honest scan. Tighten to "reject" only for a tenant that
# genuinely emits every signal.
AUTHID_MISSING_SIGNAL_OUTCOME=ignore

# Bedrock vision model for the document-upload screen. Runs in its OWN region
# because Haiku model access is commonly enabled in us-east-2, not us-east-1.
# Enable model access for this model in BEDROCK_VISION_REGION before deploy.
BEDROCK_VISION_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_VISION_REGION=us-east-2

# Custom domain (OPTIONAL). Leave BOTH commented out to serve on the CloudFront
# default *.cloudfront.net domain. If you use a custom domain, set BOTH: the
# certificate MUST be an ACM cert in us-east-1 (CloudFront requirement), and the
# domain MUST be a bare hostname (no protocol/path). The values below are
# non-functional placeholders — a synth-time guard rejects them, so uncomment
# and replace with your OWN cert/domain before enabling.
# CUSTOM_DOMAIN_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/your-certificate-id
# CUSTOM_DOMAIN_NAME=your-domain.example.com
