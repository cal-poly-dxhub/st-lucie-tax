{
  "type": "module",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*",
    "frontend"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fix": "eslint . --fix && prettier --write .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:packages": "npm run build --workspace=packages/shared-types && npm run build --workspace=packages/data-access",
    "postinstall": "npm run build:packages",
    "prepare": "husky",
    "cdk": "cdk",
    "synth": "cdk synth",
    "build:frontends": "./scripts/build-frontends.sh --no-upload",
    "deploy:frontends": "./scripts/build-frontends.sh",
    "prebuild:frontends": "npm run build:packages",
    "predeploy": "npm run build:frontends",
    "deploy": "cdk deploy --all"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "cfn-lint": "^1.9.7",
    "fix": "^0.0.3",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.20.0",
    "@vitest/coverage-v8": "^4.1.9",
    "aws-cdk": "^2.1128.1",
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.6.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "playwright": "^1.61.1",
    "prettier": "^3.8.4",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.9"
  }
}
